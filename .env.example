# Azure Document Intelligence
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<your-di-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=<your-di-key>

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-aoai-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Confidence thresholds (0.0 - 1.0)
# Fields below REMEDIATION_THRESHOLD are sent to Azure OpenAI for correction.
REMEDIATION_THRESHOLD=0.80
# Fields still below REVIEW_THRESHOLD after remediation are routed to human review.
REVIEW_THRESHOLD=0.60

# Storage paths
REVIEW_DB_PATH=./data/review.db
METRICS_LOG_PATH=./data/metrics.jsonl

# Cost model overrides (USD). Optional - sensible defaults are used if unset.
COST_DI_PER_PAGE=0.01
COST_AOAI_PROMPT_PER_1K=0.005
COST_AOAI_COMPLETION_PER_1K=0.015
